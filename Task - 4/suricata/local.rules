# CodSoft Task 4 - Local Suricata Detection Rules
# Configure HOME_NET in suricata.yaml to match the protected subnet.
# These alert-only rules do not block or drop packets.

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL NIDS - Possible TCP SYN Port Scan"; flow:stateless; flags:S; threshold:type threshold, track by_src, count 12, seconds 10; classtype:attempted-recon; sid:9000001; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL NIDS - Possible TCP SYN Flood"; flow:stateless; flags:S; threshold:type threshold, track by_dst, count 100, seconds 5; classtype:attempted-dos; sid:9000002; rev:1;)

alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL NIDS - Possible ICMP Echo Sweep"; itype:8; threshold:type threshold, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:9000003; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LOCAL NIDS - High Volume SSH Connection Attempts"; flow:stateless; flags:S; threshold:type threshold, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:9000004; rev:1;)
